# Copy this file to .env and fill in values. .env is gitignored.
# ----- AWS -----
AWS_REGION=
AWS_BUCKET=
AWS_PROJECT=
AWS_SILVER_DB=
AWS_GOLD_DB=
AWS_ROLE_ARN=

# ----- Warehouse -----
EIA_WAREHOUSE_BACKEND=duckdb            # duckdb | postgres
EIA_DUCKDB_PATH=data/warehouse.duckdb
# EIA_POSTGRES_DSN=postgresql://user:pass@localhost:5432/eia

# ----- Data root -----
EIA_DATA_ROOT=data                      # raw/, cleaned/, etc. live here

# ----- Census -----
# Get a free key at https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# ----- BLS -----
# Optional registered key (raises rate limit). https://data.bls.gov/registrationEngine/
BLS_API_KEY=

# ----- Ticketmaster -----
# Get a free key at https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=

# ----- RunSignUp -----
# Get a free key+secret at https://runsignup.com/API
RUNSIGNUP_API_KEY=
RUNSIGNUP_API_SECRET=

# ----- Setlist.fm -----
# Get a free key at https://api.setlist.fm/docs/1.0/index.html
SETLISTFM_API_KEY=

# ----- FRED (optional, used by some lookups) -----
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
